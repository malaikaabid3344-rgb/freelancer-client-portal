modules = ["nodejs-24"]
[nix]
channel = "stable-25_05"
packages = ["unzip"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "NODE_ENV=development CLIENT_URL=http://localhost:5000 sh -c '(cd server && PORT=5001 JWT_SECRET=\"$SESSION_SECRET\" node server.js) & (cd client && npm run dev -- --host 0.0.0.0 --port 5000)'"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "(cd server && PORT=5001 JWT_SECRET=\"$SESSION_SECRET\" node server.js) & (cd client && npm run preview -- --host 0.0.0.0 --port 5000)"]
build = ["bash", "-c", "npm ci --prefix client && npm ci --prefix server && cd client && VITE_API_URL=/api ./node_modules/.bin/vite build"]
