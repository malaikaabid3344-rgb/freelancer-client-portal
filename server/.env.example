# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/freelancer_portal

# Auth
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5173

# File uploads (local/mock storage for dev)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25
